{
    "git.useEditorAsCommitInput": false,  // prevent editor looking like continously busy after committing with an empty message
    "git.confirmSync": false,             // disable pop-up with confirmation questions after click on synchronise
    "git.enableSmartCommit": true,        // stage all changes when none of the changes are stages, instead of showing pop-up with a warning
    "git.postCommitCommand": "sync",      // sync automatically after each commit, prevents forgetting push to github after commit
    "git.rebaseWhenSync": false,          // rebasing can mess up the timeline
    "git.mergeEditor": true,              // open merge-editor for files under conflict
    "git.autofetch": true,                // autofetch (fetch means count, not read) changes from github periodically
    "git.autofetchPeriod": 60,            // autofetch period 60 seconds
    "merge-conflict.autoNavigateNextConflict.enabled": true, // auto navigate to next merge conflict after resolving one

    "files.exclude": {                    // hide dot-files and -folders in vscode
      ".*": true,
    },

    // AI uit: geen Copilot, geen chat, geen suggesties
    "chat.disableAIFeatures": true,       // hide and disable all built-in AI features (chat, Copilot)
    "chat.commandCenter.enabled": false,  // hide the chat button at the top of the window
    "chat.agent.enabled": false,          // disable agent mode
    "github.copilot.enable": {            // disable Copilot completions in every language
      "*": false,
    },
    "github.copilot.nextEditSuggestions.enabled": false, // disable Copilot next edit suggestions
    "editor.inlineSuggest.enabled": false, // no grey ghost-text suggestions in the editor
}